<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.machine.service.data.brand.dao.mapper.DataBrandMapper">

    <sql id="selectPageCommonConditions">
        <if test="inputDto.parentId != null and inputDto.parentId !='' ">
            AND b.parent_id = #{inputDto.parentId}
        </if>
        <if test="inputDto.status != null ">
            AND b.status = #{inputDto.status}
        </if>
        <if test="inputDto.code != null and inputDto.code !='' ">
            AND LOWER(b.code) like LOWER(CONCAT('%', #{inputDto.code}, '%'))
        </if>
        <if test="inputDto.name != null and inputDto.name !='' ">
            AND LOWER(b.name) like LOWER(CONCAT('%', #{inputDto.name}, '%'))
        </if>
        <if test="inputDto.createUserIdSet != null and inputDto.createUserIdSet.size > 0  ">
            AND b.create_by IN
            <foreach item="item" collection="inputDto.createUserIdSet" open="(" separator="," close=")">
                #{item}
            </foreach>
        </if>
        <if test="inputDto.updateUserIdSet != null and inputDto.updateUserIdSet.size > 0  ">
            AND b.update_by IN
            <foreach item="item" collection="inputDto.updateUserIdSet" open="(" separator="," close=")">
                #{item}
            </foreach>
        </if>
        <if test="inputDto.createStartTime != null ">
            AND b.create_time >= #{inputDto.createStartTime}
        </if>
        <if test="inputDto.createEndTime != null ">
            AND b.create_time <![CDATA[ <= ]]>  #{inputDto.createEndTime}
        </if>
        <if test="inputDto.updateStartTime != null ">
            AND b.update_time >= #{inputDto.updateStartTime}
        </if>
        <if test="inputDto.updateEndTime != null ">
            AND b.update_time <![CDATA[ <= ]]>  #{inputDto.updateEndTime}
        </if>
    </sql>

    <sql id="selectSimplePageConditions">
        <if test="inputDto.parentId != null and inputDto.parentId !='' ">
            AND b.parent_id = #{inputDto.parentId}
        </if>
        <if test="inputDto.keyword != null and inputDto.keyword !='' ">
            AND (LOWER(b.name) like LOWER(CONCAT('%', #{inputDto.keyword}, '%'))
            OR LOWER(b.code) like LOWER(CONCAT('%', #{inputDto.keyword}, '%')))
        </if>
        <if test="inputDto.status != null ">
            AND b.status = #{inputDto.status}
        </if>
    </sql>

    <select id="selectHasChildrenIdSet" resultType="java.lang.String">
        select distinct parent_id
        from t_data_brand
        where parent_id IN
        <foreach item="item" collection="idSet" open="(" separator="," close=")">
            #{item}
        </foreach>
    </select>

    <!-- 查询品牌的祖先链（含自身，按根节点 → 自身排序） -->
    <select id="selectAncestorList" resultType="com.machine.service.data.brand.dao.mapper.entity.DataBrandEntity">
        WITH RECURSIVE ancestor AS (SELECT b.*,
                                           0 AS depth
                                    FROM t_data_brand b
                                    WHERE b.id = #{id}
                                    UNION ALL
                                    SELECT p.*,
                                           a.depth + 1
                                    FROM t_data_brand p
                                             INNER JOIN ancestor a ON p.id = a.parent_id
                                    WHERE a.depth &lt; 10)
        SELECT *
        FROM ancestor
        ORDER BY depth DESC
    </select>

    <select id="selectPage" resultType="com.machine.service.data.brand.dao.mapper.entity.DataBrandEntity">
        select b.*
        from t_data_brand b
        <where>
            <include refid="selectPageCommonConditions"/>
        </where>
        ORDER BY b.create_time DESC
    </select>

    <select id="selectChildrenPage" resultType="com.machine.service.data.brand.dao.mapper.entity.DataBrandEntity">
        select b.*
        from t_data_brand b
        <where>
            <include refid="selectPageCommonConditions"/>
        </where>
        ORDER BY b.sort DESC, b.create_time ASC
    </select>

    <select id="selectSimplePage" resultType="com.machine.service.data.brand.dao.mapper.entity.DataBrandEntity">
        select b.*
        from t_data_brand b
        <where>
            <include refid="selectSimplePageConditions"/>
        </where>
        ORDER BY b.create_time DESC
    </select>

</mapper>