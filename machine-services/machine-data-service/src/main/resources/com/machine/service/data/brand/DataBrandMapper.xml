<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.machine.service.data.brand.dao.mapper.DataBrandMapper">

    <sql id="selectPageCommonConditions">
        <if test="inputDto.parentId != null and inputDto.parentId !='' ">
            AND b.parent_id = #{inputDto.parentId}
        </if>
        <if test="inputDto.status != null ">
            AND b.status = #{inputDto.status}
        </if>
        <if test="inputDto.code != null and inputDto.code !='' ">
            AND LOWER(b.code) like LOWER(CONCAT('%', #{inputDto.code}, '%'))
        </if>
        <if test="inputDto.name != null and inputDto.name !='' ">
            AND LOWER(b.name) like LOWER(CONCAT('%', #{inputDto.name}, '%'))
        </if>
        <if test="inputDto.namePinyinFull != null and inputDto.namePinyinFull !='' ">
            AND LOWER(b.name_pinyin_full) like LOWER(CONCAT('%', #{inputDto.namePinyinFull}, '%'))
        </if>
        <if test="inputDto.namePinyinInitial != null and inputDto.namePinyinInitial !='' ">
            AND LOWER(b.name_pinyin_initial) like LOWER(CONCAT('%', #{inputDto.namePinyinInitial}, '%'))
        </if>
        <if test="inputDto.nameEn != null and inputDto.nameEn !='' ">
            AND LOWER(b.name_en) like LOWER(CONCAT('%', #{inputDto.nameEn}, '%'))
        </if>
        <if test="inputDto.createUserIdSet != null and inputDto.createUserIdSet.size > 0  ">
            AND b.create_by IN
            <foreach item="item" collection="inputDto.createUserIdSet" open="(" separator="," close=")">
                #{item}
            </foreach>
        </if>
        <if test="inputDto.updateUserIdSet != null and inputDto.updateUserIdSet.size > 0  ">
            AND b.update_by IN
            <foreach item="item" collection="inputDto.updateUserIdSet" open="(" separator="," close=")">
                #{item}
            </foreach>
        </if>
        <if test="inputDto.createStartTime != null ">
            AND b.create_time >= #{inputDto.createStartTime}
        </if>
        <if test="inputDto.createEndTime != null ">
            AND b.create_time <![CDATA[ <= ]]>  #{inputDto.createEndTime}
        </if>
    </sql>

    <sql id="selectSimplePageConditions">
        <if test="inputDto.parentId != null and inputDto.parentId !='' ">
            AND b.parent_id = #{inputDto.parentId}
        </if>
        <if test="inputDto.keyword != null and inputDto.keyword !='' ">
            AND (LOWER(b.name) like LOWER(CONCAT('%', #{inputDto.keyword}, '%'))
            OR LOWER(b.name_pinyin_full) like LOWER(CONCAT('%', #{inputDto.keyword}, '%'))
            OR LOWER(b.name_pinyin_initial) like LOWER(CONCAT('%', #{inputDto.keyword}, '%'))
            OR LOWER(b.name_en) like LOWER(CONCAT('%', #{inputDto.keyword}, '%'))
            OR LOWER(b.code) like LOWER(CONCAT('%', #{inputDto.keyword}, '%')))
        </if>
        <if test="inputDto.status != null ">
            AND b.status = #{inputDto.status}
        </if>
    </sql>

    <select id="selectHasChildrenIdSet" resultType="java.lang.String">
        select distinct parent_id
        from t_data_brand
        where parent_id IN
        <foreach item="item" collection="idSet" open="(" separator="," close=")">
            #{item}
        </foreach>
    </select>

    <!-- 查询品牌的祖先链（含自身，按根节点 → 自身排序） -->
    <select id="selectAncestorList" resultType="com.machine.service.data.brand.dao.mapper.entity.DataBrandEntity">
        WITH RECURSIVE ancestor AS (SELECT b.*,
                                           0 AS depth
                                    FROM t_data_brand b
                                    WHERE b.id = #{id}
                                    UNION ALL
                                    SELECT p.*,
                                           a.depth + 1
                                    FROM t_data_brand p
                                             INNER JOIN ancestor a ON p.id = a.parent_id
                                    WHERE a.depth &lt; 10)
        SELECT *
        FROM ancestor
        ORDER BY depth DESC
    </select>

    <select id="selectPage" resultType="com.machine.service.data.brand.dao.mapper.entity.DataBrandEntity">
        SELECT t.* FROM (
        SELECT b.*
        FROM t_data_brand b
        <if test="inputDto.categoryIdSet != null and inputDto.categoryIdSet.size > 0">
            INNER JOIN t_data_brand_category_relation bcr ON bcr.brand_id = b.id
        </if>
        <where>
            <if test="inputDto.categoryIdSet != null and inputDto.categoryIdSet.size > 0">
                AND bcr.category_id IN
                <foreach item="item" collection="inputDto.categoryIdSet" open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>
            <include refid="selectPageCommonConditions"/>
        </where>
        GROUP BY b.id

        <!-- 当需要包含未分配品牌时 -->
        <if test="inputDto.containVirtualNode != null and inputDto.containVirtualNode">
            UNION

            <!-- 查询未分配分类的品牌 -->
            SELECT b.*
            FROM t_data_brand b
            WHERE NOT EXISTS (
            SELECT 1 FROM t_data_brand_category_relation bcr
            WHERE bcr.brand_id = b.id
            )
            <include refid="selectPageCommonConditions"/>
        </if>
        ) t
        ORDER BY t.name_pinyin_initial
    </select>

    <select id="selectChildrenPage" resultType="com.machine.service.data.brand.dao.mapper.entity.DataBrandEntity">
        SELECT t.* FROM (
        SELECT b.*
        FROM t_data_brand b
        <if test="inputDto.categoryIdSet != null and inputDto.categoryIdSet.size > 0">
            INNER JOIN t_data_brand_category_relation bcr ON bcr.brand_id = b.id
        </if>
        <where>
            <if test="inputDto.categoryIdSet != null and inputDto.categoryIdSet.size > 0">
                AND bcr.category_id IN
                <foreach item="item" collection="inputDto.categoryIdSet" open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>
            <include refid="selectPageCommonConditions"/>
        </where>
        GROUP BY b.id

        <!-- 当需要包含未分配品牌时 -->
        <if test="inputDto.containVirtualNode != null and inputDto.containVirtualNode">
            UNION

            <!-- 查询未分配分类的品牌 -->
            SELECT b.*
            FROM t_data_brand b
            WHERE NOT EXISTS (
            SELECT 1 FROM t_data_brand_category_relation bcr
            WHERE bcr.brand_id = b.id
            )
            <include refid="selectPageCommonConditions"/>
        </if>
        ) t
        ORDER BY t.sort DESC, t.name_pinyin_initial
    </select>

    <select id="selectSimplePage" resultType="com.machine.service.data.brand.dao.mapper.entity.DataBrandEntity">
        select b.*
        from t_data_brand b
        <where>
            <include refid="selectSimplePageConditions"/>
        </where>
        ORDER BY b.name_pinyin_initial
    </select>

</mapper>