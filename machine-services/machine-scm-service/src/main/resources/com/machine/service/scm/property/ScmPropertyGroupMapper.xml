<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.machine.service.scm.property.dao.mapper.ScmPropertyGroupMapper">

    <select id="listByBackCategoryId" resultType="com.machine.service.scm.property.dao.mapper.entity.ScmPropertyGroupEntity">
        select * from t_scm_property_group where back_category_id = #{backCategoryId} order by sort desc
    </select>

    <select id="listByBackCategoryIdSet" resultType="com.machine.service.scm.property.dao.mapper.entity.ScmPropertyGroupEntity">
        select * from t_scm_property_group where back_category_id in
        <foreach item="item" collection="backCategoryIdSet" open="(" separator="," close=")">
            #{item}
        </foreach>
        order by sort desc
    </select>

    <delete id="deleteByBackCategoryId">
        delete from t_scm_property_group where back_category_id = #{backCategoryId}
    </delete>

    <select id="countByBackCategoryAndName" resultType="java.lang.Integer">
        select count(0) from t_scm_property_group where back_category_id = #{backCategoryId} and name = #{name}
    </select>

</mapper>