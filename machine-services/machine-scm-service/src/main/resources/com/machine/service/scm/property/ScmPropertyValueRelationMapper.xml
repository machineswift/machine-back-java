<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.machine.service.scm.property.dao.mapper.ScmPropertyValueRelationMapper">

    <select id="listChildPropertyIdByParentValueId" resultType="java.lang.String">
        select child_property_id from t_scm_property_value_relation where parent_value_id = #{parentValueId} order by sort desc
    </select>

    <select id="listByParentValueIdSet" resultType="com.machine.service.scm.property.dao.mapper.entity.ScmPropertyValueRelationEntity">
        select * from t_scm_property_value_relation where parent_value_id in
        <foreach item="item" collection="parentValueIdSet" open="(" separator="," close=")">
            #{item}
        </foreach>
        order by sort desc
    </select>

    <delete id="deleteByParentValueId">
        delete from t_scm_property_value_relation where parent_value_id = #{parentValueId}
    </delete>

    <delete id="deleteByChildPropertyId">
        delete from t_scm_property_value_relation where child_property_id = #{childPropertyId}
    </delete>

    <select id="countByParentValueAndChildProperty" resultType="java.lang.Integer">
        select count(0) from t_scm_property_value_relation where parent_value_id = #{parentValueId} and child_property_id = #{childPropertyId}
    </select>

</mapper>